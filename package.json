{
  "name": "pvpcale",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:desktop": "vue-tsc -b && vite build --mode electron && electron-builder --win nsis dir && node scripts/pack-desktop.mjs",
    "preview": "vite preview",
    "release": "npm run build && node scripts/pack-release.mjs",
    "release:desktop": "npm run build:desktop"
  },
  "dependencies": {
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "terser": "^5.48.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.3.5"
  },
  "build": {
    "appId": "com.pvpcale.app",
    "productName": "PVPCale",
    "directories": {
      "output": "release-desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PVPCale",
      "artifactName": "PVPCale-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  }
}
